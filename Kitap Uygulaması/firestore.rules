rules_version = '2';

// Okur — Firestore güvenlik kuralları
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function pid(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function isFriend(uid) {
      let path = /databases/$(database)/documents/friendships/$(pid(uid, request.auth.uid));
      return exists(path) && get(path).data.status == 'accepted';
    }

    // Kişisel veriler: yalnızca sahibi
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // @kullanıcı adı → uid (+ @ad ile giriş için e-posta).
    // Tek belge okunabilir, liste/tarama kapalı; yalnızca sahibi oluşturur/siler.
    match /usernames/{nick} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && nick.matches('^[a-z0-9_.]{3,20}$');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Arkadaşların görebildiği özet profil (seri, okunan kitaplar, haftalık sayfa)
    match /publicProfiles/{uid} {
      allow write: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || isFriend(uid));
    }

    // Arkadaşlık: istek → kabul. Belge kimliği iki uid'in sıralı birleşimi.
    match /friendships/{id} {
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.requester == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && id == pid(request.resource.data.members[0], request.resource.data.members[1]);
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.requester
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }
  }
}
